# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-facing user-service host (login/register call this directly)
NEXT_PUBLIC_USER_SERVICE_HOST=http://127.0.0.1:8001

# Server-side service hosts (refresh + clinic)
USER_SERVICE_HOST=http://127.0.0.1:8001/
CLINIC_SERVICE_HOST=http://127.0.0.1:8000/

# Cookie TTLs (backend owns real token expiry)
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=2592000

# When true, questionnaires + consult polling use local fixtures
# (clinic GET /api/v1/questionnaires and POST/GET /api/v1/consults)
USE_QUESTIONNAIRE_FIXTURES=false
